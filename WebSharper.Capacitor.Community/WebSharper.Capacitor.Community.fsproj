<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Product>WebSharper.Capacitor.Commnuity</Product>
    <Title>https://github.com/dotnet-websharper/capacitor.community/</Title>
    <Company>IntelliFactory</Company>
    <Copyright>(c) 2023 IntelliFactory</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <NpmDependencies>
      <NpmPackage Name="@capacitor-community/app-icon" Version="&gt;= 7.0.0 &lt; 8.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/apple-sign-in" Version="&gt;= 7.1.0 &lt; 8.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/background-geolocation" Version="&gt;= 1.3.1 &lt; 2.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/bluetooth-le" Version="&gt;= 8.3.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/camera-preview" Version="&gt;= 8.0.2 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/contacts" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/date-picker" Version="&gt;= 7.1.0 &lt; 8.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/device-check" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/facebook-login" Version="&gt;= 8.1.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/file-opener" Version="&gt;= 8.0.1 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/image-to-text" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/in-app-review" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/intercom" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/keep-awake" Version="&gt;= 8.0.1 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/media" Version="&gt;= 9.1.0 &lt; 10.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/native-audio" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/photoviewer" Version="&gt;= 8.0.1 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/privacy-screen" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/safe-area" Version="&gt;= 8.0.1 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/screen-brightness" Version="&gt;= 8.0.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/security-provider" Version="&gt;= 7.0.0 &lt; 8.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/speech-recognition" Version="&gt;= 7.0.1 &lt; 8.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/sqlite" Version="&gt;= 8.1.1 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/stripe" Version="&gt;= 8.3.0 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/text-to-speech" Version="&gt;= 8.0.2 &lt; 9.0.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@capacitor-community/volume-buttons" Version="&gt;= 8.0.1 &lt; 9.0.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>